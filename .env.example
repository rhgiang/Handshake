# Handshake environment. One file for every service, grouped by where each value is used.
# Local development: copy to ./.env at the repo root. The backend reads it (backend/env.mjs).
# Production: the same ./.env goes on the Vultr VM (/root/handshake.env, then backend/deploy/setup.sh).
# Never commit .env. Only put on the VM what the backend needs (sections 1 and 2, plus 3 and 4 once set up).
#
# Where it runs        | Service      | Purpose
# ---------------------+--------------+-------------------------------------------
# Vercel               | frontend/    | Frontend and public website
# Vultr                | backend/     | Backend API
# Tiger Data Cloud     | (hosted)     | Database
# n8n Cloud            | n8n/         | Email automation
# Maritime             | agent/       | AI agent hosting
# (called by backend)  | Gemini       | AI model
# (inside n8n Cloud)   | Gmail        | SMTP for n8n emails and testing
# GoDaddy              | not needed   |

# ---------------------------------------------------------------------------
# 1. Vultr backend: API
# ---------------------------------------------------------------------------
PORT=8787
# Bind address. Leave unset locally; the VM sets 127.0.0.1 so only Caddy can reach the API.
HOST=
# Proxy hops in front of Express: Caddy only = 1. Unset locally.
# Needed so the per-IP rate limits see the visitor. Verify with a real request.
TRUST_PROXY_HOPS=
# Browser origins allowed to call this API directly (CORS), comma-separated, exact match,
# e.g. https://your-app.vercel.app. Unset locally (Vite proxies /api, so no CORS is needed).
ALLOWED_ORIGIN=
# Keep disabled until the documented H4 human snapshot gate passes.
SNAPSHOT_ENABLED=0
# Development-only export of cached replies into backend/precache.json. Off in production.
CACHE_EXPORT_ENABLED=0

# ---------------------------------------------------------------------------
# 2. Gemini (called only by the Vultr backend and the Maritime agent; never the browser)
# ---------------------------------------------------------------------------
# Create at https://aistudio.google.com/apikey. Unset = the API answers with mock replies.
GEMINI_API_KEY=
# Change if AI Studio shows a different free-tier model.
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# 3. Tiger Data Cloud database (TimescaleDB; backend/schema.sql uses create_hypertable)
# ---------------------------------------------------------------------------
# Unset = attempt writes are no-ops and #/stats shows an empty state.
# Connection string from the Tiger Cloud console, including sslmode=require (never commit it).
DATABASE_URL=

# ---------------------------------------------------------------------------
# 4. n8n Cloud (email automation). All three are required; unset = notifications off.
# ---------------------------------------------------------------------------
# Production webhook URLs from the imported n8n/ workflows (https only).
N8N_SUBSCRIBE_URL=
N8N_EVENT_URL=
# Optional: n8n status webhook (n8n/status.json); enables GET /api/notify-status.
N8N_STATUS_URL=
# Same value as the Header Auth credential (X-Handshake-Secret) in n8n Cloud.
N8N_SECRET=
# Gmail SMTP is NOT configured here: add it as an SMTP credential inside n8n Cloud
# (a dedicated Gmail account with an app password). Never put it in this repo.

# ---------------------------------------------------------------------------
# 5. Maritime planner agent (agent/). Both required; unset or unreachable = local planner.
# ---------------------------------------------------------------------------
MARITIME_AGENT_URL=
# Same value as AGENT_TOKEN in the agent's own Maritime secrets.
MARITIME_AGENT_TOKEN=
# Agent-only secrets live in Maritime, not here: AGENT_TOKEN, GEMINI_API_KEY, APP_URL.

# ---------------------------------------------------------------------------
# 6. Vercel frontend (set in the Vercel project, not here; this value is PUBLIC)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://<api-hostname>   e.g. https://203-0-113-10.sslip.io (the Vultr API, HTTPS)
# Unset locally: the browser calls relative /api/* and Vite proxies it to :8787.
