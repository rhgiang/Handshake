{
  "name": "Handshake weekly confirmed-learner recap",
  "active": false,
  "nodes": [
    {
      "id": "Monday-UTC",
      "name": "Monday UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "Manual-operator-test",
      "name": "Manual operator test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {},
      "disabled": true
    },
    {
      "id": "Claim-recaps",
      "name": "Claim recaps",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select handshake.confirmed_recap_claim() as result",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
      }
    },
    {
      "id": "Fetch-stats",
      "name": "Fetch stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "url": "={{ $vars.HANDSHAKE_APP_ORIGIN + \"/api/stats/\" + encodeURIComponent($json.result.learnerId) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "Weighted-stats",
      "name": "Weighted stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        960,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select handshake.recap_stats($1::jsonb) as result",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      }
    },
    {
      "id": "Recheck-recap",
      "name": "Recheck recap",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select handshake.confirmed_recap_recheck($1,$2::uuid) as result",
        "options": {
          "queryReplacement": "={{ [$('Claim recaps').item.json.result.learnerId, $('Claim recaps').item.json.result.lease] }}"
        }
      }
    },
    {
      "id": "Learner-still-subscribed",
      "name": "Learner still subscribed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "send",
              "leftValue": "={{ $json.result.send === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "Send-recap",
      "name": "Send recap",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        240,
        240
      ],
      "parameters": {
        "fromEmail": "={{ $vars.HANDSHAKE_FROM_EMAIL }}",
        "toEmail": "={{ $json.result.email }}",
        "subject": "Ready for another ASL session?",
        "emailFormat": "both",
        "text": "={{ \"Ready for another ASL session?\\n\\nA little practice goes a long way. Your last 14 days: \" + $(\"Weighted stats\").item.json.result.attempts + \" attempts. \" + ($(\"Weighted stats\").item.json.result.share === null ? \"No attempts recorded yet.\" : \"Reference match share: \" + $(\"Weighted stats\").item.json.result.share + \"%.\") + \"\\n\\nOpen Handshake and pick up where you left off.\\n\\nOpt out of all practice emails: \" + $vars.HANDSHAKE_LINK_ORIGIN + \"/webhook/handshake-learner-unsubscribe?token=\" + encodeURIComponent($json.result.unsubscribeToken) }}",
        "html": "={{ (() => { const attempts=$('Weighted stats').item.json.result.attempts; const share=$('Weighted stats').item.json.result.share; const summary=share===null?'No attempts recorded yet — a short session still counts.':('Reference match share: '+share+'%.'); const stop=$vars.HANDSHAKE_LINK_ORIGIN+'/webhook/handshake-learner-unsubscribe?token='+encodeURIComponent($json.result.unsubscribeToken); return \"<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width'><title>Handshake</title></head><body style='margin:0;padding:0;background:#f4f7f9;font-family:Inter,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;color:#0b1f33'><div style='display:none;max-height:0;overflow:hidden;opacity:0;color:transparent'>Time to get back into ASL practice on Handshake.</div><table role='presentation' width='100%' cellspacing='0' cellpadding='0' style='background:#f4f7f9;padding:40px 16px'><tr><td align='center'><table role='presentation' width='100%' cellspacing='0' cellpadding='0' style='max-width:560px;background:#ffffff;border:1px solid #d7e0e8;border-radius:16px;overflow:hidden'><tr><td style='height:4px;background:#0f766e;font-size:0;line-height:0'>&nbsp;</td></tr><tr><td style='padding:28px 32px 8px'><p style='margin:0;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#0f766e'>Handshake</p><p style='margin:10px 0 0;font-size:13px;color:#5b6b7c'>Practice reminder</p><h1 style='margin:14px 0 0;font-size:28px;line-height:1.25;font-weight:650;letter-spacing:-0.02em;color:#0b1f33'>\" + \"Ready for another ASL session?\" + \"</h1>\" + \"<div style='margin:18px 0 0;font-size:16px;line-height:1.6;color:#0b1f33'>\" + \"<p style='margin:0 0 12px'>A little practice goes a long way. Jump back into Handshake when you have a few minutes.</p>\" + \"<p style='margin:0'>Here is how the last couple of weeks looked:</p>\" + \"</div>\" + \"<table role='presentation' width='100%' cellspacing='0' cellpadding='0' style='margin:22px 0 0;background:#e6f4f2;border-radius:12px'><tr><td style='padding:16px 18px'>\" + \"<table role='presentation' width='100%' cellspacing='0' cellpadding='0'><tr>\" + \"<td style='padding:0 8px 0 0;width:50%'><p style='margin:0;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#0f766e'>Attempts</p><p style='margin:8px 0 0;font-size:28px;font-weight:700;line-height:1;color:#0b1f33'>\" + String(attempts) + \"</p></td>\" + \"<td style='padding:0 0 0 8px;width:50%'><p style='margin:0;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#0f766e'>Progress</p><p style='margin:8px 0 0;font-size:16px;font-weight:650;line-height:1.35;color:#0b1f33'>\" + String(summary) + \"</p></td></tr></table>\" + \"</td></tr></table>\" + \"<p style='margin:28px 0 0;font-size:15px;line-height:1.5;color:#0b1f33'><strong>Open Handshake</strong> and pick up where you left off.</p>\" + \"<hr style='border:none;border-top:1px solid #d7e0e8;margin:32px 0 18px'>\" + \"<p style='margin:0;font-size:13px;line-height:1.55;color:#5b6b7c'>You opted in to practice reminders. You can opt out anytime.</p>\" + \"<p style='margin:14px 0 0;font-size:12px;line-height:1.5;color:#5b6b7c'><a href='\" + String(stop) + \"' style='color:#5b6b7c;text-decoration:underline'>Opt out of all practice emails</a></p>\" + \"</td></tr></table>\" + \"<p style='margin:18px 0 0;font-size:11px;line-height:1.4;color:#5b6b7c;font-family:Inter,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif'>Handshake · practice reminders</p>\" + \"</td></tr></table></body></html>\"; })() }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "Recap-sent",
      "name": "Recap sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select handshake.recap_finish($1,$2::uuid,true)",
        "options": {
          "queryReplacement": "={{ [$('Claim recaps').item.json.result.learnerId, $('Claim recaps').item.json.result.lease] }}"
        }
      }
    },
    {
      "id": "Recap-failed",
      "name": "Recap failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select handshake.recap_finish($1,$2::uuid,false)",
        "options": {
          "queryReplacement": "={{ [$('Claim recaps').item.json.result.learnerId, $('Claim recaps').item.json.result.lease] }}"
        }
      }
    },
    {
      "id": "Report-recap-SMTP-failure",
      "name": "Report recap SMTP failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        960,
        240
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Recap delivery failed; lease released, delivery unconfirmed."
      }
    }
  ],
  "connections": {
    "Monday UTC": {
      "main": [
        [
          {
            "node": "Claim recaps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual operator test": {
      "main": [
        [
          {
            "node": "Claim recaps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim recaps": {
      "main": [
        [
          {
            "node": "Fetch stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch stats": {
      "main": [
        [
          {
            "node": "Weighted stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Weighted stats": {
      "main": [
        [
          {
            "node": "Recheck recap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recheck recap": {
      "main": [
        [
          {
            "node": "Learner still subscribed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Learner still subscribed": {
      "main": [
        [
          {
            "node": "Send recap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send recap": {
      "main": [
        [
          {
            "node": "Recap sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Recap failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recap failed": {
      "main": [
        [
          {
            "node": "Report recap SMTP failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "executionTimeout": 60
  },
  "pinData": {}
}
